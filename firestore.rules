rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    match /candidates/{id} {
      allow read, write: if signedIn();
    }

    match /processes/{id} {
      allow read, write: if signedIn();
    }

    match /items/{id} {
      allow read, write: if signedIn();
    }

    match /audits/{id} {
      allow read, create: if signedIn();
      // Once an audit is signed, the client can never write to it again —
      // this is the real fix for the old app's stuck sign-off button
      // (a UI DisplayMode.Disabled check that could desync from the data).
      // Reopening a signed audit has to go through a supervisor tool that
      // uses elevated (e.g. Admin SDK / Cloud Function) access, not this
      // client-facing rule.
      allow update: if signedIn() && resource.data.status != 'signed';
    }
  }
}
