rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Every auditor's data lives under users/{uid}/... — an auditor can only
    // read or write inside their own uid's subtree, so one signed-up account
    // never sees another account's candidates, item bank, or audits, even
    // though sign-up itself is open to anyone.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /candidates/{id} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /processes/{id} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /items/{id} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /audits/{id} {
        allow read, create: if request.auth != null && request.auth.uid == uid;
        // Once an audit is signed, it can never be written again by anyone
        // — including its own owner — matching the "locked, reopening needs
        // a supervisor" note shown on the Sign-off screen.
        allow update: if request.auth != null && request.auth.uid == uid && resource.data.status != 'signed';
      }
    }
  }
}
